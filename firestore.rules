rules_version = '2';

// Reglas de desarrollo / prueba: lectura pública y escritura para cualquier usuario autenticado en Firebase
service cloud.firestore {
  match /databases/{database}/documents {
    match /blogs/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
