rules_version = '2';

// Lectura pública y escritura para administradores autenticados en Firebase
service cloud.firestore {
  match /databases/{database}/documents {
    match /blogs/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
