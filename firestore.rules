rules_version = '2';

// Lectura pública solo de artículos publicados; escritura solo para los correos de administración.
// ADMIN_EMAILS: agrega aquí los correos creados en Firebase Authentication.
// Mientras la lista esté vacía, NADIE puede escribir ni leer borradores (seguro por defecto).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [];
    }

    match /blogs/{postId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
